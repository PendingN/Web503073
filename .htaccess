# Keep repository metadata, runtime state, local configuration, and development
# files outside the public surface when Apache serves the project root.

<FilesMatch "(?i)^(?:\.gitignore|\.env(?:\..*)?|AGENTS\.md|README(?:\..*)?|.*\.(?:bak|conf|dist|ini|log|old|orig|save|sql|sql\.gz|swp))$">
    Require all denied
</FilesMatch>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)(?:\.git|\.runtime)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)(?:config|database|scripts|tests)(?:/|$) - [F,L,NC]
</IfModule>
